---
// The FOH frame around every spec demo: slim ink bar, always visible.
// FOH-branded per FOH-DESIGN.md (the demo below it is NOT FOH-branded).
// personalize.js fills [data-foh-for], the [data-foh-cta] href, and the
// Color & vibe panel (swatches are fitted to the current vibe in the browser).
import Logo from "../Logo.astro";
import type { TemplateDef } from "../../data/templates";

interface Props {
  t: TemplateDef;
}
const { t } = Astro.props;
---

<header class="foh-bar">
  <a class="foh-bar__brand" href="/templates">
    <Logo variant="mark" theme="reversed" />
    <span class="foh-bar__word">Front of House</span>
  </a>
  <p class="foh-bar__label">
    {t.label} direction · <span data-foh-for>try it with your name</span>
  </p>
  <div class="foh-bar__actions">
    <button type="button" class="foh-bar__edit" data-foh-edit>
      Change details
    </button>
    <button
      type="button"
      class="foh-bar__look"
      data-foh-look
      aria-expanded="false"
      aria-controls="foh-look"
    >
      <span class="foh-bar__look-chip" data-foh-look-chip aria-hidden="true"></span>
      <span class="foh-bar__look-text">Color &amp; vibe</span>
    </button>
    <button
      type="button"
      class="foh-bar__icon"
      data-foh-share
      aria-label="Copy link to this version"
      title="Copy link to this version"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
        <path
          d="M10.5 13.5 13.5 10.5M8.8 15.2l-1.6 1.6a3.11 3.11 0 0 1-4.4-4.4l3.2-3.2a3.11 3.11 0 0 1 4.4 0M15.2 8.8l1.6-1.6a3.11 3.11 0 0 1 4.4 4.4l-3.2 3.2a3.11 3.11 0 0 1-4.4 0"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
      </svg>
      <span class="foh-bar__copied" data-foh-copied hidden>Copied</span>
    </button>
    <a class="foh-bar__cta" data-foh-cta href="/templates/brief">Build your brief</a>
  </div>
  <div class="foh-look" id="foh-look" data-foh-look-panel role="region" aria-label="Color and vibe" hidden>
    <div class="foh-look__group">
      <p class="foh-look__label">Vibe</p>
      <div class="foh-look__seg">
        {t.vibes.map((v) => (
          <button type="button" data-look-vibe={v.key} aria-pressed="false">
            <strong>{v.label}</strong>
            <span>{v.hint}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="foh-look__group">
      <p class="foh-look__label">Brand color</p>
      <div class="foh-look__swatches" data-look-swatches></div>
      <p class="foh-look__status" data-look-status aria-live="polite"></p>
    </div>
    {
      t.accentFinish !== false && (
        <div class="foh-look__group">
          <p class="foh-look__label">Buttons</p>
          <div class="foh-look__seg foh-look__seg--finish">
            <button type="button" data-look-finish="solid" aria-pressed="true"><strong>Solid</strong></button>
            <button type="button" data-look-finish="tonal" aria-pressed="false"><strong>Tonal gradient</strong></button>
          </div>
        </div>
      )
    }
    <button type="button" class="foh-look__done" data-look-close>Done</button>
  </div>
</header>

<style>
  .foh-bar {
    position: sticky;
    top: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.55rem clamp(1rem, 3vw, 1.8rem);
    background: #221c18;
    color: #f4ecdd;
    border-bottom: 2px solid #c75b39;
  }
  .foh-bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex: none;
  }
  .foh-bar__brand :global(.logo__awning) {
    width: 1.9rem;
  }
  .foh-bar__word {
    font-family: "Cormorant", Georgia, serif;
    font-weight: 600;
    font-size: 1.12rem;
    color: #f4ecdd;
    white-space: nowrap;
  }
  .foh-bar__label {
    margin: 0;
    font-family: "Inter Variable", "Inter", "Helvetica Neue", sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #c9bba0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }
  .foh-bar__label [data-foh-for] {
    color: #f4ecdd;
  }
  .foh-bar__actions {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    margin-left: auto;
  }
  .foh-bar__edit,
  .foh-bar__cta,
  .foh-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-family: "Inter Variable", "Inter", "Helvetica Neue", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.42rem 1.05rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease,
      border-color 0.18s ease, transform 0.16s ease;
  }
  .foh-bar__icon {
    position: relative;
    min-width: 44px;
    padding: 0.42rem;
    background: transparent;
    color: #c9bba0;
    border: 1.5px solid #3a322b;
  }
  .foh-bar__icon:hover {
    color: #f4ecdd;
    border-color: #c9bba0;
  }
  .foh-bar__copied {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: #f4ecdd;
    color: #221c18;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .foh-bar__edit {
    background: transparent;
    color: #f4ecdd;
    border: 1.5px solid #3a322b;
  }
  .foh-bar__edit:hover {
    border-color: #c9bba0;
  }
  .foh-bar__cta {
    background: #c75b39;
    color: #fbf7f0;
    border: 1.5px solid transparent;
    text-decoration: none;
  }
  .foh-bar__cta:hover {
    background: #a8472b;
  }
  .foh-bar__cta:active,
  .foh-bar__edit:active {
    transform: translateY(1px);
  }
  .foh-bar :is(a, button):focus-visible {
    outline: 2.5px solid #c75b39;
    outline-offset: 3px;
  }

  .foh-bar__look {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.42rem 0.95rem 0.42rem 0.5rem;
    border-radius: 999px;
    border: 1.5px solid #3a322b;
    background: transparent;
    color: #f4ecdd;
    font-family: "Inter Variable", "Inter", "Helvetica Neue", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.18s ease;
  }
  .foh-bar__look:hover,
  .foh-bar__look[aria-expanded="true"] {
    border-color: #c9bba0;
  }
  .foh-bar__look-chip {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--chip, #c75b39);
    box-shadow: inset 0 0 0 1.5px rgba(244, 236, 221, 0.35);
    transition: background 0.2s ease;
  }

  /* Color & vibe panel: drops from the bar, applies live, no submit. */
  .foh-look {
    position: absolute;
    top: calc(100% + 8px);
    right: clamp(0.6rem, 2vw, 1.4rem);
    width: min(25rem, calc(100vw - 1.2rem));
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    padding: 1.1rem 1.15rem 1rem;
    border: 1px solid #e4d9c4;
    border-radius: 14px;
    background: #fbf7f0;
    color: #4a4038;
    box-shadow: 0 2px 6px rgba(34, 28, 24, 0.08), 0 22px 50px rgba(34, 28, 24, 0.18);
    font-family: "Inter Variable", "Inter", "Helvetica Neue", sans-serif;
    animation: foh-look-in 0.18s ease both;
  }
  .foh-look[hidden] {
    display: none;
  }
  @keyframes foh-look-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .foh-look__group + .foh-look__group {
    margin-top: 1rem;
  }
  .foh-look__label {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c75b39;
  }
  .foh-look__seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .foh-look__seg button {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1.5px solid #e4d9c4;
    border-radius: 9px;
    background: #fff;
    color: #221c18;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .foh-look__seg strong {
    font-size: 0.86rem;
    font-weight: 600;
  }
  .foh-look__seg span {
    font-size: 0.74rem;
    color: #9a8e7e;
    margin-top: 0.1rem;
  }
  .foh-look__seg button[aria-pressed="true"] {
    border-color: #c75b39;
    box-shadow: 0 0 0 3px rgba(199, 91, 57, 0.14);
  }
  .foh-look__swatches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem 0.35rem;
  }
  .foh-look :global(.foh-look__swatch) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .foh-look :global(.foh-look__chip) {
    position: relative;
    display: block;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--chip, #ddd);
    box-shadow: inset 0 0 0 1px rgba(34, 28, 24, 0.14);
    transition: box-shadow 0.16s ease, transform 0.16s ease;
  }
  .foh-look :global(.foh-look__swatch:hover .foh-look__chip) {
    transform: translateY(-1px);
  }
  .foh-look :global(.foh-look__swatch[aria-pressed="true"] .foh-look__chip),
  .foh-look :global(.foh-look__swatch--custom.is-on .foh-look__chip) {
    box-shadow: 0 0 0 2px #fbf7f0, 0 0 0 4px #c75b39;
  }
  .foh-look :global(.foh-look__chip--custom) {
    background: conic-gradient(from 90deg, #c3352b, #e9a13b, #7a8b3a, #256d67, #1f5f8b, #8a3a52, #c3352b);
    overflow: hidden;
  }
  .foh-look :global(.foh-look__chip--custom input) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }
  .foh-look :global(.foh-look__swatch--custom:focus-within .foh-look__chip) {
    outline: 2.5px solid #c75b39;
    outline-offset: 4px;
  }
  .foh-look :global(.foh-look__name) {
    max-width: 100%;
    overflow: hidden;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.2;
    color: #4a4038;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .foh-look__status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.1rem;
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: #4a4038;
  }
  .foh-look__status[data-state="adjusted"] {
    color: #8a4b12;
  }
  .foh-look__status :global(svg) {
    flex: none;
  }
  .foh-look__done {
    width: 100%;
    min-height: 44px;
    margin-top: 1rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background: #c75b39;
    color: #fbf7f0;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }
  .foh-look__done:hover {
    background: #a8472b;
  }
  .foh-look :is(button, summary):focus-visible {
    outline: 2.5px solid #c75b39;
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .foh-bar__label {
      display: none;
    }
    .foh-bar {
      gap: 0.55rem;
    }
    .foh-bar__brand {
      margin-right: auto;
    }
    .foh-bar__edit {
      padding-inline: 0.75rem;
    }
  }
  @media (max-width: 560px) {
    .foh-bar__look {
      padding-right: 0.5rem;
    }
    .foh-bar__look-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    /* A bottom sheet on phones keeps the hero and name in view. */
    .foh-look {
      position: fixed;
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      max-height: 72dvh;
      border-radius: 16px 16px 0 0;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
      animation-name: foh-sheet-in;
    }
    @keyframes foh-sheet-in {
      from {
        transform: translateY(24px);
        opacity: 0;
      }
    }
  }
  @media (max-width: 480px) {
    .foh-bar__word {
      display: none;
    }
    .foh-bar [data-foh-share] {
      display: none;
    }
    .foh-bar__cta {
      padding-inline: 0.8rem;
    }
  }
</style>
