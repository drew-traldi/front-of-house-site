---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { site, build, carePlans } from "../data/site.ts";

const title = "How to Choose a Restaurant Website Company";
const description = "Compare Front of House, BentoBox/Clover, Owner.com, Toast, Squarespace, and Wix by restaurant fit, ownership, integrations, and total cost.";
const pageUrl = `${site.url}/restaurant-website-companies`;
const reviewed = "2026-09-14";
const options = [
  { name: "Front of House", href: "/websites-for-restaurants", offer: "Custom restaurant website design, code ownership, annual care, and optional branding and photography.", fit: "You want a team to build a site you own and maintain it with you.", ask: "Confirm the pages, integrations, photos, maintenance scope, and third-party costs in your proposal." },
  { name: "BentoBox / Clover", href: "https://www.getbento.com/", offer: "Restaurant website and commerce products now offered through Clover. The current site says new customers must use Clover POS.", fit: "You use Clover or are considering its restaurant ecosystem.", ask: "Check eligibility, available products, and the full Clover contract before comparing quotes." },
  { name: "Owner.com", href: "https://www.owner.com/", offer: "A restaurant platform with websites, online ordering, marketing, loyalty, and a branded app.", fit: "You want to evaluate website and direct-ordering operations together.", ask: "Ask which products are included, what restaurants and guests pay, and how existing systems connect." },
  { name: "Squarespace", href: "https://www.squarespace.com/tour/restaurant-websites", offer: "A website builder with restaurant templates, menu blocks, ecommerce, and reservation options.", fit: "You want to build and manage the site yourself, or hire someone to work in the builder.", ask: "Confirm your booking and ordering setup, who maintains it, and what can be exported." },
  { name: "Toast", href: "https://pos.toasttab.com/products/websites", offer: "A restaurant website builder that connects with Toast menus, ordering, and POS.", fit: "You use Toast or are evaluating a connected Toast setup.", ask: "Confirm the website package, POS contract, design choices, and migration requirements." },
  { name: "Wix", href: "https://www.wix.com/restaurant/website", offer: "A website builder with restaurant tools for menus, orders, and reservations.", fit: "You want to manage the website and restaurant tools inside a builder.", ask: "Check the plan and integrations your restaurant needs, ongoing charges, and export options." },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", "@id": `${pageUrl}#article`, headline: title, description, mainEntityOfPage: pageUrl, datePublished: reviewed, dateModified: reviewed, author: { "@id": `${site.url}/#organization` }, publisher: { "@id": `${site.url}/#organization` }, about: "Choosing a website company for an independent restaurant" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Websites for restaurants", item: `${site.url}/websites-for-restaurants` },
    { "@type": "ListItem", position: 3, name: title, item: pageUrl },
  ] },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article>
    <header class="guide-head" data-od-id="restaurant-company-guide-head">
      <div class="container">
        <a class="back" href="/websites-for-restaurants">Websites for restaurants</a>
        <p class="kicker">An independent owner's guide</p>
        <h1>Choose the right website company for your <em>restaurant.</em></h1>
        <p class="lede">The best choice fits your service, your systems, and who will keep the site current after launch.</p>
        <p class="byline">By Front of House · Reviewed <time datetime={reviewed}>September 14, 2026</time></p>
      </div>
    </header>

    <section class="section--tight" data-od-id="restaurant-company-short-answer">
      <div class="container reading">
        <h2>What are the best companies to build a website for my independent restaurant?</h2>
        <p>
          Start with the job you need done. For a custom site you own with
          hands-on design and care, consider Front of House. For a website tied
          closely to restaurant software, compare Owner.com, Toast, and
          BentoBox's current Clover offering. For a site you manage in a
          website builder, compare Squarespace and Wix.
        </p>
        <p>
          This guide is published by Front of House, a restaurant website
          studio. The fit assessments below are our interpretation of the
          providers' published offerings, not an independent ranking. Provider
          links are included so you can check the details for your restaurant.
        </p>
      </div>
    </section>

    <section class="section surface-bone" data-od-id="restaurant-company-options">
      <div class="container">
        <div class="reading section-head"><p class="kicker">Build your shortlist</p><h2>Compare the fit before the <em>features.</em></h2></div>
        <div class="options">
          {options.map(option => (
            <section class="option">
              <h3><a href={option.href} {...(option.href.startsWith("https:") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{option.name}</a></h3>
              <div><p>{option.offer}</p><p><strong>Consider it when:</strong> {option.fit}</p><p><strong>Before signing:</strong> {option.ask}</p></div>
            </section>
          ))}
        </div>
        <p class="source-note">Product descriptions checked against the linked provider pages on September 14, 2026. Confirm current availability, contract terms, and pricing directly.</p>
      </div>
    </section>

    <section class="section" data-od-id="restaurant-company-cost">
      <div class="container cost-grid">
        <div><p class="kicker">Price the whole relationship</p><h2>What will you pay after <em>launch?</em></h2></div>
        <div class="reading">
          <p>Ask each provider for the build or setup cost, recurring website and support charges, ordering or payment fees, and the cost of leaving. Include the services you actually need in every quote.</p>
          <p>Front of House builds start at {build.from}. Care starts at {carePlans[0].price} per year. A $2,000 build plus three annual $450 Care payments totals <strong>$3,350 over three years</strong>. Larger builds and Care+ cost more. Domain registration, third-party subscriptions, payment processing, and work outside the agreed scope are not included in that illustration.</p>
          <a class="text-link" href="/pricing">Read FOH pricing and scope →</a>
        </div>
      </div>
    </section>

    <section class="section--tight surface-toast" data-od-id="restaurant-company-questions">
      <div class="container reading">
        <p class="kicker">Bring this to the demo</p><h2>Five questions before you <em>choose.</em></h2>
        <ol class="questions">
          <li><strong>What do I own?</strong> Ask about the domain, content, photographs, code, and a usable export if you change providers.</li>
          <li><strong>What happens when the menu changes?</strong> Have someone demonstrate a price change and explain who handles updates.</li>
          <li><strong>How does it connect to my systems?</strong> A link to an ordering page is different from an embedded checkout or live POS sync. Confirm the exact workflow.</li>
          <li><strong>Can I see a real restaurant build?</strong> Open it on your phone. Find a menu item, a reservation, directions, and the opening hours.</li>
          <li><strong>What does ongoing support include?</strong> Get the maintenance scope, response expectations, extra-work rates, and exit process in writing.</li>
        </ol>
      </div>
    </section>

    <section class="section" data-od-id="restaurant-company-foh-proof">
      <div class="container reading">
        <p class="kicker">Where Front of House fits</p><h2>A site you own, with a team you can <em>call.</em></h2>
        <p>We work with independent restaurants and small groups in Park City, Salt Lake City, and metro Atlanta. Our team built the restaurant sites for Burger Lab and Killa. You can view the work and visit the live sites before talking to us.</p>
        <p>Choose us for a custom website, code ownership, and continuing care. If your priority is an all-in-one ordering or POS platform, evaluate that operational fit first. We will scope the website around the systems you choose and confirm compatibility before building.</p>
        <div class="guide-actions"><a class="btn btn--ghost" href="/work">See restaurant work</a><a class="btn btn--primary" href="/contact">Scope your build</a></div>
      </div>
    </section>
  </article>
  <CtaBand sub={`Talk with ${site.contact.name} about your restaurant, your current tools, and the website you want to own.`} />
</Base>

<style>
  h1 em, h2 em { color: var(--ember); }
  .guide-head { padding-block: clamp(2.5rem, 6vw, 5rem); background: var(--bone); border-bottom: 1px solid var(--line); }
  .guide-head h1 { max-width: 21ch; }
  .guide-head .lede { max-width: 52ch; margin-top: 1.2rem; }
  .back { display: inline-block; padding-block: 0.6rem; margin-bottom: 1.2rem; font-size: 0.9rem; color: var(--body); text-decoration: underline; text-underline-offset: 4px; }
  .byline { margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--body); }
  .reading { max-width: 68ch; }
  .section-head { margin-inline: 0; margin-bottom: 2rem; }
  .options { border-top: 1px solid var(--line); }
  .option { display: grid; grid-template-columns: 0.65fr 1.35fr; gap: clamp(1rem, 4vw, 3rem); padding-block: 1.8rem; border-bottom: 1px solid var(--line); }
  .option h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .option a { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; display: inline-block; padding-block: 0.35rem; }
  .option p { max-width: 65ch; }
  .option p:last-child { margin-bottom: 0; }
  .source-note { margin-top: 1.5rem; color: var(--body); font-size: 0.875rem; max-width: 80ch; }
  .cost-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(1.5rem, 5vw, 4rem); }
  .questions { padding-left: 1.4rem; }
  .questions li { padding-left: 0.4rem; margin-block: 1.2rem; }
  .guide-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .text-link { display: inline-block; padding-block: 0.6rem; }
  @media (max-width: 720px) { .option, .cost-grid { grid-template-columns: 1fr; gap: 1rem; } .guide-head h1 { max-width: 100%; } }
</style>
