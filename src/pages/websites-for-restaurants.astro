---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import VideoSlot from "../components/VideoSlot.astro";
import { build, carePlans, caseStudies, site } from "../data/site.ts";

const pageFaq = [
  {
    q: "What is the best website company for an independent restaurant?",
    a: `The right company depends on who will update the site, the restaurant's ordering and reservation systems, the full cost, and what the owner can take when leaving. Front of House is a fit for independent restaurants that want a custom website they own, hands-on design and support, and flat yearly care. Our builds start at ${build.from}, with Care from ${carePlans[0].price} per year, serving Park City, Salt Lake City, and metro Atlanta.`,
  },
  {
    q: "What should a restaurant website include?",
    a: "A restaurant website should make the menu, hours, location, reservations, and online ordering easy to find on a phone. It should also load quickly, reflect the restaurant's real atmosphere, and give search engines accurate information they can understand.",
  },
  {
    q: "How much does a custom restaurant website cost?",
    a: `Front of House custom restaurant websites start at ${build.from}. The final price depends on the menu, number of pages, integrations, locations, photography, video, and brand work. After launch, Care starts at ${carePlans[0].price} per year.`,
  },
  {
    q: "Does the restaurant own the website?",
    a: "Yes. Front of House clients own their website and its code outright. Every Care plan includes an exit kit, so the restaurant can leave with the complete site instead of losing a website it rented.",
  },
  {
    q: "Can you connect online ordering and reservations?",
    a: "We scope the website around the ordering, reservation, waitlist, and email tools the restaurant uses. A link or embedded booking form is different from a live POS integration. We confirm compatibility, implementation work, and any third-party charges in the proposal before building.",
  },
  {
    q: "Where does Front of House build restaurant websites?",
    a: "Front of House is currently focused on restaurants in Park City, Utah, Salt Lake City, Utah, and metro Atlanta, Georgia.",
  },
  {
    q: "Are Front of House websites built for Google and AI search?",
    a: "Yes. Every build includes a crawlable technical foundation, structured data that matches the visible page, mobile-first performance, and clear restaurant information. Those fundamentals help traditional search engines and AI-powered search systems understand the restaurant.",
  },
] as const;

const inclusions = [
  {
    n: "01",
    title: "A menu guests can use",
    body: "Readable on a phone, searchable on the web, and structured around how people decide what to order.",
  },
  {
    n: "02",
    title: "A direct path to the table",
    body: "Reservations, ordering, calls, and directions placed where a hungry guest expects to find them.",
  },
  {
    n: "03",
    title: "Your restaurant, not a template",
    body: "Custom design shaped by the room, the food, and the service, with on-site photo and video when you need it.",
  },
  {
    n: "04",
    title: "A foundation built to be found",
    body: "Fast pages, accurate metadata, structured information, and clear answers for Google and AI-powered search.",
  },
] as const;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${site.url}/websites-for-restaurants#webpage`,
    url: `${site.url}/websites-for-restaurants`,
    name: "Websites for Independent Restaurants",
    description:
      "Custom websites for restaurants in Park City, Salt Lake City, and metro Atlanta. Built for menus, reservations, ordering, and search. The restaurant owns the code.",
    about: { "@id": `${site.url}/#organization` },
    breadcrumb: { "@id": `${site.url}/websites-for-restaurants#breadcrumb` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/websites-for-restaurants#service`,
    name: "Custom Websites for Restaurants",
    serviceType: "Restaurant website design and development",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: site.areaServed.map((area) => ({
      "@type": "Place",
      name: area,
    })),
    description:
      "Custom, mobile-first restaurant websites with menus, ordering and reservation integrations, structured data, and code ownership.",
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: "2000",
      description:
        "Custom restaurant website builds start at $2,000. Final pricing is based on scope.",
      url: `${site.url}/pricing`,
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${site.url}/websites-for-restaurants#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.url,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Websites for Restaurants",
        item: `${site.url}/websites-for-restaurants`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: pageFaq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title="Websites for Independent Restaurants"
  description="Front of House builds custom websites for independent restaurants in Atlanta, Park City, and Salt Lake City. Own your code. Builds from $2,000; Care from $450/year."
  jsonLd={jsonLd}
>
  <section class="hero" data-od-id="restaurant-websites-hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="kicker">Websites for restaurants</p>
        <h1>Custom restaurant websites you <em>own.</em></h1>
        <p class="lede">
          Front of House designs and builds custom websites for independent
          restaurants and small groups in Park City, Salt Lake City, and metro
          Atlanta. Your menu, reservations, and ordering come first. Builds
          start at {build.from}, with Care from {carePlans[0].price} per year.
        </p>
        <div class="hero__actions">
          <a href="/contact" class="btn btn--primary">Scope your website</a>
          <a href="/work" class="btn btn--ghost">See restaurant sites</a>
        </div>
        <p class="hero__contact">
          Talk with {site.contact.name}:
          <a href={site.contact.phoneHref}>{site.contact.phone}</a>
        </p>
      </div>

      <aside class="ownership" aria-label="Website ownership summary">
        <div class="ownership__head">
          <span>Front of House</span>
          <span>Build docket 001</span>
        </div>
        <p class="ownership__label">Property check</p>
        <h2>Your restaurant website</h2>
        <dl class="ownership__list">
          <div>
            <dt>Owner</dt>
            <dd>You</dd>
          </div>
          <div>
            <dt>Custom code</dt>
            <dd>Included</dd>
          </div>
          <div>
            <dt>Monthly website rent</dt>
            <dd>$0</dd>
          </div>
          <div>
            <dt>Care after launch</dt>
            <dd>From $450/year</dd>
          </div>
        </dl>
        <p class="ownership__stamp">Owner-owned</p>
      </aside>
    </div>

    <div class="container markets" aria-label="Current service areas">
      <span>Now serving</span>
      {site.areaServed.map((area) => <strong>{area}</strong>)}
    </div>
  </section>

  <section id="choosing-a-company" class="section--tight" data-od-id="restaurant-website-buyer-fit">
    <div class="container buyer-fit">
      <div>
        <p class="kicker">Choosing your website company</p>
        <h2>The right fit for your <em>restaurant.</em></h2>
      </div>
      <div>
        <p>
          Choose Front of House if you want a custom site you own, a team to
          design and maintain it, and optional branding, photography, and video.
          We start with your restaurant's current tools and confirm the scope
          before quoting.
        </p>
        <p>
          A self-service builder may suit an owner who wants to handle the
          design and updates. A restaurant platform may suit a team prioritizing
          built-in ordering, marketing, or POS connections. Compare the full
          cost and exit terms alongside the design.
        </p>
        <a class="text-link" href="/restaurant-website-companies">Compare restaurant website companies and what to ask →</a>
      </div>
    </div>
  </section>

  <section
    id="what-a-restaurant-website-needs"
    class="section surface-toast"
    data-od-id="restaurant-website-jobs"
  >
    <div class="container">
      <header class="section-head">
        <p class="kicker">Before dinner</p>
        <h2>Your website has a <em>shift</em> to work.</h2>
        <p class="lede">
          A good restaurant website does not make guests hunt. It answers the
          practical questions quickly, then gives them a clear next move.
        </p>
      </header>
      <div class="inclusions">
        {
          inclusions.map((item) => (
            <article class="inclusion">
              <span class="inclusion__n">{item.n}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="quote surface-dusk" data-od-id="ownership-testimonial">
    <div class="container quote__inner">
      <p class="kicker">From the owners' table</p>
      <blockquote>
        “Front of House built our sites professionally, cost-effectively, and
        with AI visibility in mind. Any restaurant owner paying monthly should
        take ownership and have a website that is truly <em>theirs.</em>”
      </blockquote>
      <p class="quote__credit">Killa &amp; Burger Lab Co-owner</p>
    </div>
  </section>

  <section id="own-vs-rent" class="section" data-od-id="ownership-comparison">
    <div class="container compare-grid">
      <div class="compare-copy">
        <p class="kicker">Own it, don't rent it</p>
        <h2>A website should be an <em>asset.</em></h2>
        <p class="lede">
          Subscription platforms can keep charging after the build is long
          finished. Front of House separates the thing you own from the care
          that keeps it current.
        </p>
        <p>
          Buy the custom website once. Keep us for hosting, maintenance, and
          support through a flat yearly Care plan. If you leave, your site
          leaves with you.
        </p>
        <a href="/pricing" class="text-link">See full pricing and scope →</a>
      </div>

      <div class="compare-table" role="region" aria-label="Website ownership comparison" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">The question</th>
              <th scope="col">Subscription platform</th>
              <th scope="col">Front of House</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Who owns the code?</th>
              <td>Check the contract</td>
              <td>You do</td>
            </tr>
            <tr>
              <th scope="row">How do you pay?</th>
              <td>Check recurring fees</td>
              <td>Build once, care yearly</td>
            </tr>
            <tr>
              <th scope="row">Can you take it elsewhere?</th>
              <td>Check export rights</td>
              <td>Yes, with your full code</td>
            </tr>
            <tr>
              <th scope="row">Is the design yours?</th>
              <td>Check customization limits</td>
              <td>Custom to your restaurant</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section
    id="restaurant-website-examples"
    class="section surface-bone"
    data-od-id="restaurant-website-work"
  >
    <div class="container">
      <header class="section-head section-head--split">
        <div>
          <p class="kicker">Restaurant website examples</p>
          <h2>Built for a real <em>service.</em></h2>
        </div>
        <p>
          Two different rooms, two different menus, two websites built around
          what each restaurant needs a guest to do next.
        </p>
      </header>

      <div class="work-grid">
        {
          caseStudies.map((study) => (
            <article class="work-card">
              <a
                class="work-card__media"
                href={study.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit the ${study.name} website`}
              >
                <VideoSlot src={study.video} alt={study.alt} />
                <span>Live website</span>
              </a>
              <div class="work-card__body">
                <p class="work-card__location">{study.location}</p>
                <h3>{study.name}</h3>
                <p>{study.blurb}</p>
                <a href={study.url} target="_blank" rel="noopener noreferrer">
                  Visit {study.name} →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="what-is-included"
    class="section"
    data-od-id="restaurant-website-inclusions"
  >
    <div class="container build-grid">
      <div class="build-copy">
        <p class="kicker">What the build includes</p>
        <h2>The whole digital <em>front door.</em></h2>
        <p class="lede">
          We scope every build to the restaurant instead of forcing the
          restaurant into a package.
        </p>
      </div>
      <ul class="build-list">
        <li><strong>Menu:</strong> readable HTML pages, not a hard-to-use PDF alone</li>
        <li><strong>Guest actions:</strong> reservations, ordering, calls, and directions</li>
        <li><strong>Mobile:</strong> thumb-ready layouts and fast-loading pages</li>
        <li><strong>Search:</strong> metadata, structured data, sitemap, and crawl access</li>
        <li><strong>Brand:</strong> custom visual direction, with identity work if needed</li>
        <li><strong>Content:</strong> on-site restaurant photography and video when scoped</li>
        <li><strong>Care:</strong> hosting, maintenance, backups, and hands-on changes</li>
        <li><strong>Ownership:</strong> your code and an exit kit if you ever leave</li>
      </ul>
    </div>
  </section>

  <section class="second-quote" data-od-id="service-testimonial">
    <div class="container second-quote__inner">
      <blockquote>
        “The website their team built for me was excellent, and the customer
        service is quick and helpful. I have complete control and ownership of
        my site, so I can make changes as needed without additional costs.”
      </blockquote>
      <p>Owner, Dasks Greek Grill</p>
    </div>
  </section>

  <section id="faq" class="section surface-toast" data-od-id="restaurant-website-faq">
    <div class="container faq-wrap">
      <header class="section-head">
        <p class="kicker">Straight answers</p>
        <h2>Questions about restaurant <em>websites.</em></h2>
      </header>
      <div class="faq-list">
        {
          pageFaq.map((item) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Put your restaurant online, then own the room."
    sub={`Talk with ${site.contact.name} about a custom restaurant website in Park City, Salt Lake City, or metro Atlanta.`}
  />
</Base>

<style>
  .buyer-fit {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .buyer-fit p { max-width: 65ch; }
  .buyer-fit .text-link { display: inline-block; padding-block: 0.6rem; }
  @media (max-width: 820px) {
    .buyer-fit { grid-template-columns: 1fr; }
  }
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) 0;
    background:
      linear-gradient(90deg, transparent 0 72%, rgba(199, 91, 57, 0.06) 72%),
      var(--paper);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.75fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }
  .hero__copy {
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .hero h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 7.2vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .hero h1 em,
  .buyer-fit h2 em,
  .section-head h2 em,
  .compare-copy h2 em,
  .build-copy h2 em {
    color: var(--ember);
    font-weight: inherit;
  }
  .hero .lede {
    margin-top: 1.4rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero__contact {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  .hero__contact a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ownership {
    position: relative;
    background: var(--ink);
    color: var(--muted-on-ink);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.3rem);
    box-shadow: var(--shadow-lift);
    transform: rotate(1.2deg);
  }
  .ownership::before,
  .ownership::after {
    content: "";
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    height: 1px;
    background: var(--ink-border);
  }
  .ownership::before {
    top: 3.6rem;
  }
  .ownership::after {
    bottom: 1.2rem;
  }
  .ownership__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.6rem;
    color: var(--muted-on-ink);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ownership__label {
    margin: 1.2rem 0 0.35rem;
    color: var(--ember-bright);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ownership h2 {
    color: var(--paper);
    font-size: clamp(2rem, 3vw, 2.7rem);
  }
  .ownership__list {
    margin: 1.6rem 0 2.2rem;
  }
  .ownership__list div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--ink-border);
  }
  .ownership__list dt {
    color: var(--muted-on-ink);
  }
  .ownership__list dd {
    margin: 0;
    color: var(--paper);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .ownership__stamp {
    width: fit-content;
    margin: 0 0 0 auto;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--ember-bright);
    color: var(--ember-bright);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }
  .markets {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
  }
  .markets span {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .markets strong {
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .section-head {
    max-width: 700px;
    margin-bottom: clamp(2rem, 5vw, 3.4rem);
  }
  .section-head .lede {
    margin-top: 1rem;
  }
  .inclusions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .inclusion {
    min-height: 230px;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .inclusion__n {
    display: block;
    margin-bottom: 2.5rem;
    color: var(--ember-deep);
    font-family: var(--display);
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }
  .inclusion p {
    max-width: 46ch;
    margin: 0;
  }

  .quote {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }
  .quote__inner {
    max-width: 980px;
  }
  .quote blockquote {
    margin: 0;
    color: var(--paper);
    font-family: var(--display);
    font-size: clamp(2.15rem, 5.5vw, 4.4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .quote blockquote em {
    color: var(--ember-bright);
  }
  .quote__credit {
    margin: 1.8rem 0 0;
    color: var(--muted-on-ink);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .compare-copy {
    position: sticky;
    top: 120px;
  }
  .compare-copy .lede {
    margin-top: 1rem;
  }
  .text-link {
    display: inline-block;
    min-height: 44px;
    margin-top: 0.7rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ember);
    text-underline-offset: 5px;
  }
  .compare-table {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .compare-table table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    background: var(--paper);
  }
  .compare-table th,
  .compare-table td {
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .compare-table thead th {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .compare-table thead th:last-child {
    color: var(--ember-bright);
  }
  .compare-table tbody th {
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.95rem;
  }
  .compare-table tbody td:last-child {
    color: var(--ink);
    font-weight: 600;
  }
  .compare-table tr:last-child th,
  .compare-table tr:last-child td {
    border-bottom: 0;
  }

  .section-head--split {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    max-width: none;
  }
  .section-head--split > p {
    margin: 0 0 0.7rem;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .work-card {
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .work-card__media {
    position: relative;
    display: block;
    height: clamp(250px, 35vw, 390px);
    padding: 0.65rem;
    background: var(--ink);
  }
  .work-card__media span {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .work-card__body {
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .work-card__location {
